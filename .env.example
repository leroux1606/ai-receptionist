# ---- Public app URL (no trailing slash). Used in webhooks, emails, redirects.
APP_URL=http://localhost:3000

# ---- Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- Voice: Vapi
VAPI_API_KEY=your-vapi-private-key
# Voice provider + id for every customer's receptionist (pick one that sounds right)
VAPI_VOICE_PROVIDER=11labs
VAPI_VOICE_ID=your-voice-id
# LLM model name used by the receptionist
VAPI_MODEL=gpt-4o-mini

# Master key that per-customer webhook secrets are derived from.
# Generate with:  openssl rand -base64 48   (min 32 characters; never commit)
WEBHOOK_MASTER_KEY=

# ---- Billing: Paystack (ZAR). Create 3 plans in the dashboard, paste codes.
PAYSTACK_SECRET_KEY=
PAYSTACK_PLAN_STARTER=
PAYSTACK_PLAN_PRO=
PAYSTACK_PLAN_BUSINESS=

# ---- Email: Resend (call summaries to the business owner)
RESEND_API_KEY=
EMAIL_FROM="Your Brand <receptionist@yourdomain.com>"

# ---- Scheduled job auth (Vercel sets this automatically for crons)
CRON_SECRET=
